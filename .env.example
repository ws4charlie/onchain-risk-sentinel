# Copy to .env and fill in. Never commit .env.

# Model providers (read by the provider packages)
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=

# Models per role: "<provider>:<model>" (see langchain init_chat_model)
# Default for every role: openrouter:google/gemini-3.5-flash-lite
# SENTINEL_SUPERVISOR_MODEL=openai:gpt-5.4-mini
# SENTINEL_SPECIALIST_MODEL=openrouter:google/gemini-3.5-flash-lite
# SENTINEL_SCORER_MODEL=openai:gpt-5.4-mini
# SENTINEL_CRITIC_MODEL=openai:gpt-5.4-mini

# Data sources
SENTINEL_ETHERSCAN_API_KEY=
# Node providers (RPC-first chain data; Etherscan becomes the fallback and names contracts)
# Ethereum mainnet JSON-RPC URLs in priority order, comma-separated (Alchemy, QuickNode, Ankr, ...).
# URLs may embed keys. Each URL is tried in turn; Etherscan is the last fallback.
SENTINEL_ETH_RPC_URLS=
# Alchemy key: address history via the Transfers API (also serves JSON-RPC if no URL is set).
SENTINEL_ALCHEMY_API_KEY=

# Runtime (CLI / API)
# Postgres for checkpoints (resume paused cases across processes) and the pgvector index.
# Unset: in-memory checkpoints and a local numpy pattern index.
# SENTINEL_DATABASE_URL=postgresql://localhost/sentinel
# Pattern embeddings: "google" (needs GOOGLE_API_KEY) or "hashing" (offline).
# SENTINEL_EMBEDDING_PROVIDER=google
# SENTINEL_EMBEDDING_MODEL=gemini-embedding-001

# Optional Langfuse tracing (install with: uv sync --extra tracing)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
